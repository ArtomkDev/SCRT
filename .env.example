# Required server configuration. Copy locally; never commit populated credentials.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_GUILD_MEMBERS_INTENT=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional server-only Activity artwork providers (configure bot and web).
STEAMGRIDDB_API_KEY=
IGDB_TWITCH_CLIENT_ID=
IGDB_TWITCH_CLIENT_SECRET=

# Media control plane (same independent random secret on bot and web, >=32 characters).
MEDIA_INTERNAL_SECRET=
# Bot: loopback locally; use :: for Railway private IPv6/IPv4 routing.
MEDIA_INTERNAL_HOST=127.0.0.1
MEDIA_INTERNAL_PORT=3100
# Railway bot service only: RAILPACK_CONFIG_FILE=railpack.bot.json (installs FFmpeg).
# Web: local origin, Railway private origin, or HTTPS bot origin.
MEDIA_BOT_URL=http://127.0.0.1:3100
# Bot-only playback runtime and optional metadata providers.
MEDIA_FFMPEG_PATH=ffmpeg
# Optional metadata fallback only; YouTube/SoundCloud audio needs no API key.
YOUTUBE_API_KEY=
