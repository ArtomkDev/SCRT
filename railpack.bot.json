{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": { "commands": ["corepack pnpm install --frozen-lockfile --prod=false"] },
    "build": { "commands": ["corepack pnpm --filter @scrt/bot build"] }
  },
  "deploy": {
    "startCommand": "corepack pnpm --filter @scrt/bot start",
    "aptPackages": ["...", "ffmpeg"]
  }
}
