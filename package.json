{
  "name": "scrt",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @scrt/bot --filter @scrt/web dev",
    "dev:bot": "corepack pnpm --filter @scrt/bot dev",
    "dev:web": "corepack pnpm --filter @scrt/web dev",
    "build": "corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "deploy:commands": "corepack pnpm --filter @scrt/bot deploy:commands",
    "verify:live": "corepack pnpm --filter @scrt/bot verify:live"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vitest": "^5.0.2",
    "eslint": "^10.11.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.0.0"
  }
}
